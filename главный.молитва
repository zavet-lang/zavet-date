# Работа с датами и русским склонением интервалов времени.

пусть МЕСЯЦЫ_ИМ = [
    "январь", "февраль", "март", "апрель", "май", "июнь",
    "июль", "август", "сентябрь", "октябрь", "ноябрь", "декабрь"
]

пусть МЕСЯЦЫ_РОД = [
    "января", "февраля", "марта", "апреля", "мая", "июня",
    "июля", "августа", "сентября", "октября", "ноября", "декабря"
]

открой слово склонить(n: целое, форма1: строка, форма2: строка, форма5: строка) -> строка
    пусть м100 = абс(n) % 100
    пусть м10 = м100 % 10
    если м100 >= 11 и м100 <= 19
        аминь форма5
    конец
    если м10 == 1
        аминь форма1
    конец
    если м10 >= 2 и м10 <= 4
        аминь форма2
    конец
    аминь форма5
конец

открой слово високосный(год: целое) -> булево
    если год % 400 == 0
        аминь истина
    конец
    если год % 100 == 0
        аминь ложь
    конец
    аминь год % 4 == 0
конец

открой слово дней_в_месяце(год: целое, месяц: целое) -> целое
    если месяц < 1 или месяц > 12
        бросить "номер месяца должен быть от 1 до 12, дано: {месяц}"
    конец
    пусть дни = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    если месяц == 2 и високосный(год)
        аминь 29
    конец
    аминь дни[месяц - 1]
конец

открой слово название_месяца(месяц: целое, родительный = ложь) -> строка
    если месяц < 1 или месяц > 12
        бросить "номер месяца должен быть от 1 до 12, дано: {месяц}"
    конец
    если родительный
        аминь МЕСЯЦЫ_РОД[месяц - 1]
    конец
    аминь МЕСЯЦЫ_ИМ[месяц - 1]
конец

слово два_знака(ч: целое) -> строка
    если ч < 10
        аминь "0" + строка(ч)
    конец
    аминь строка(ч)
конец

открой слово формат_из(год: целое, месяц: целое, день: целое, час: целое = 0, мин: целое = 0, со_временем = ложь) -> строка
    пусть мес = название_месяца(месяц, истина)
    пусть основа = "{день} {мес} {год}"
    если со_временем
        аминь "{основа}, {два_знака(час)}:{два_знака(мин)}"
    конец
    аминь основа
конец

открой слово формат_рус(сек = ничего, со_временем = ложь) -> строка
    пусть с = сек ?? время.сейчас()
    пусть изо = время.строка(с, "2006-01-02 15:04")
    пусть части = разделить(изо, " ")
    пусть д_части = разделить(части[0], "-")
    пусть в_части = разделить(части[1], ":")
    пусть год = число(д_части[0])
    пусть мес = число(д_части[1])
    пусть день = число(д_части[2])
    пусть час = число(в_части[0])
    пусть мин = число(в_части[1])
    аминь формат_из(год, мес, день, час, мин, со_временем)
конец

открой слово назад(событие_сек: целое, сейчас_сек = ничего) -> строка
    пусть т = сейчас_сек ?? время.сейчас()
    измени разн = т - событие_сек
    если разн < 0
        разн = 0
    конец
    если разн < 60
        аминь "только что"
    конец
    пусть мин = разн // 60
    если мин < 60
        пусть сл_мин = склонить(мин, "минуту", "минуты", "минут")
        аминь "{мин} {сл_мин} назад"
    конец
    пусть час = мин // 60
    если час < 24
        пусть сл_час = склонить(час, "час", "часа", "часов")
        аминь "{час} {сл_час} назад"
    конец
    пусть дн = час // 24
    пусть сл_дн = склонить(дн, "день", "дня", "дней")
    аминь "{дн} {сл_дн} назад"
конец
