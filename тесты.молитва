приими дата из "./главный.молитва"

тест "високосный год и дни в месяце"
    проверить дата.високосный(2024) == истина
    проверить дата.високосный(1900) == ложь
    проверить дата.високосный(2000) == истина
    проверить дата.дней_в_месяце(2024, 2) == 29
    проверить дата.дней_в_месяце(2025, 2) == 28
    проверить дата.дней_в_месяце(2026, 11) == 30
конец

тест "форматирование и склонение"
    проверить дата.формат_из(2026, 11, 26) == "26 ноября 2026"
    проверить дата.формат_из(2026, 1, 5, 9, 3, истина) == "5 января 2026, 09:03"
    проверить дата.название_месяца(5) == "май"

    проверить дата.назад(1000, 1020) == "только что"
    проверить дата.назад(1000, 1060) == "1 минуту назад"
    проверить дата.назад(1000, 1300) == "5 минут назад"
    проверить дата.назад(1000, 1000 + 7200) == "2 часа назад"
    проверить дата.назад(0, 86400 * 21) == "21 день назад"
конец
